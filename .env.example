# BANDGESTÃO AI — variáveis de SERVIDOR (Vercel → Settings → Environment Variables).
# Nunca use o prefixo VITE_ nestas chaves e nunca as coloque no código do navegador.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cifra das chaves de IA guardadas pela escola (texto aleatório longo, 32+ caracteres).
# Guarde-o: se o alterar, as chaves já guardadas deixam de ser legíveis e têm de ser introduzidas de novo.
AI_KEYS_SECRET=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_ACCESS_TOKEN=
WHATSAPP_AI_PHONE_NUMBER_ID=
WHATSAPP_AI_VERIFY_TOKEN=
WHATSAPP_AI_APP_SECRET=
WHATSAPP_AI_GRAPH_VERSION=v26.0
WHATSAPP_AI_BUSINESS_NUMBER=

# Inteligência artificial — TODAS OPCIONAIS.
# O normal é cada escola colar as suas chaves em Configurações → Integrações → BANDGESTÃO AI (ficam cifradas por escola).
# Estas variáveis são a CHAVE GLOBAL: servem de reserva a todas as escolas que não tenham chave própria (ou cujas chaves falhem). Pode definir uma, várias ou nenhuma.
GEMINI_API_KEY=            # gratuita: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=              # gratuita: https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=        # modelos :free em https://openrouter.ai/keys
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
