# Copie para .env e preencha. Nunca ponha aqui a chave service_role do Supabase.

# Supabase (painel → Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Captcha Cloudflare Turnstile (opcional; ver docs/CAPTCHA_SUPABASE.md)
VITE_TURNSTILE_SITE_KEY=

# Versão que aparece nos relatórios de erro (opcional; ver docs/MONITORIZACAO_ERROS.md)
VITE_APP_VERSION=

# Tradução automática com a API oficial do Google (opcional, só no servidor/Vercel)
GOOGLE_TRANSLATE_API_KEY=
